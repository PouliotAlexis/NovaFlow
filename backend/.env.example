# NovaFlow Backend Environment Variables
# Copier ce fichier en .env et remplir les valeurs

# Mode AI: "local" (Ollama), "cloud" (OpenAI), ou "groq"
AI_MODE=local

# Ollama (Local AI) - Pas besoin de clé API
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Cloud AI (Optionnel - Seulement si AI_MODE=cloud)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq AI (Optionnel - Si AI_MODE=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Discord Bot
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=
WEB_APP_URL=http://localhost:3000

# Database
DATABASE_URL=sqlite:///./novaflow.db

# Security
SECRET_KEY=change-this-in-production

# Microsoft Azure Integration
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback
